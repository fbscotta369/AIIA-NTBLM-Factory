# =============================================================================
# AIIA-NTBLM-Factory — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git. It is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Google / NotebookLM
# -----------------------------------------------------------------------------
# Password for fbscotta@gmail.com (use app-password if 2FA is enabled)
NOTEBOOKLM_PASSWORD=your_google_password_or_app_password

# Google API Key (for YouTube Data API v3)
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# AI Tools
# -----------------------------------------------------------------------------
# ElevenLabs API key (for TTS — female voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenRouter API key (for LLM analysis + content generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# Supabase (optional — for tracking generated products)
# -----------------------------------------------------------------------------
# Reused from AIIA-Factory
SUPABASE_URL=https://tvloyxabyzzdxwalwveu.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# Optional: OpenAI (fallback for TTS if ElevenLabs unavailable)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Output configuration
# -----------------------------------------------------------------------------
# Directory for generated products (default: ./output)
OUTPUT_DIR=output

# Site URL (for asset links in PDFs)
SITE_URL=https://aiia-ntblm-factory.vercel.app